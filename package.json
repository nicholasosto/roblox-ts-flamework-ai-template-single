{
	"name": "roblox-ts-flamework-template",
	"version": "1.0.0",
	"description": "A single-package Roblox-TS game project using Flamework framework",
	"main": "out/init.lua",
	"scripts": {
		"build": "rbxtsc",
		"watch": "rbxtsc -w",
		"serve": "rojo serve default.project.json",
		"dev": "concurrently \"npm:watch\" \"npm:serve\"",
		"lint": "eslint src --ext .ts",
		"format": "prettier --write \"src/**/*.ts\""
	},
	"keywords": [
		"roblox",
		"roblox-ts",
		"flamework",
		"game"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@flamework/core": "^1.3.0",
		"@flamework/components": "^1.3.0",
		"@flamework/networking": "^1.3.0",
		"@rbxts/services": "^1.5.4",
		"@rbxts/signal": "^1.1.1",
		"@rbxts/t": "^3.1.1"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"prettier": "^3.2.5",
		"rbxts-transformer-flamework": "^1.3.0",
		"roblox-ts": "^3.0.0",
		"typescript": "^5.6.3",
		"@rbxts/types": "^1.0.806",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"concurrently": "^8.2.2"
	}
}
